{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "server.js",
      "admin.js",
      "auth.js"
    ],
    "rewrites": [
      { "source": "/login",    "destination": "/login.html" },
      { "source": "/registro", "destination": "/registro.html" },
      { "source": "/admin",    "destination": "/admin.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=7200" }
        ]
      }
    ]
  }
}
